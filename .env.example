# Copy to ".env" in the repo root for `docker compose` and local dev.
# Vercel: set the same keys under Project → Settings → Environment Variables
#   (at minimum NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, plus
#   SUPABASE_SERVICE_ROLE_KEY for server APIs that bypass RLS if needed).
# Never commit real keys. Values below are placeholders.

# --- OpenAI (optional: richer distress NLP on the simulator) ---
OPENAI_API_KEY=

# --- Supabase (recommended: auth, persistence, AI router token storage) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=
# Browser / Next.js public (safe to expose); must match your project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- WebSocket: separate fleet simulator (server/). Next.js on Vercel/Render does NOT run it. ---
# Local dev: leave unset → client uses ws://localhost:8080
# Production: deploy server/ as its own service, then e.g. NEXT_PUBLIC_WS_URL=wss://your-sim.onrender.com
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_PORT=8080
